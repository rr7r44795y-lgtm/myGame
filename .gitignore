# ==============================================================
# Unity 项目 .gitignore
# 入库范围：Assets/ Packages/ ProjectSettings/（含全部 .meta）
# 其余均为本地生成，不入库
# ==============================================================

# ---------------- Unity 自动生成目录 ----------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 下载缓存
/[Aa]ssets/AssetStoreTools*

# Unity Accelerator / Cache Server
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------- IDE / 编辑器 ----------------
# Visual Studio 缓存目录
.vs/
.vsconfig

# Rider
.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio Code
.vscode/

# Gradle（Android 构建）
.gradle/

# ---------------- 自动生成的工程文件 ----------------
# 这些由 Unity 根据 Assets 内容重新生成，不应入库
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------- 构建产物 ----------------
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/*.bytes

# Unity3D 生成的元数据文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Build 报告
sysinfo.txt

# ---------------- 操作系统 ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
